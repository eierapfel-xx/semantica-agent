{"attached_files_info": null, "law_info": {"law_type": "Act", "law_id": "129AC0000000089", "law_num": "明治二十九年法律第八十九号", "law_num_era": "Meiji", "law_num_year": 29, "law_num_type": "Act", "law_num_num": "089", "promulgation_date": "1896-04-27"}, "revision_info": {"law_revision_id": "129AC0000000089_20260624_508AC0000000045", "law_type": "Act", "law_title": "民法", "law_title_kana": "みんぽう", "abbrev": "", "category": "民事", "updated": "2026-06-24T10:58:58+09:00", "amendment_promulgate_date": "2026-06-24", "amendment_enforcement_date": "2026-06-24", "amendment_enforcement_comment": null, "amendment_scheduled_enforcement_date": null, "amendment_law_id": "508AC0000000045", "amendment_law_title": "民法等の一部を改正する法律", "amendment_law_title_kana": null, "amendment_law_num": "令和八年法律第四十五号", "amendment_type": "3", "repeal_status": "None", "repeal_date": null, "remain_in_force": false, "mission": "New", "current_revision_status": "CurrentEnforced"}, "law_full_text": {"tag": "Law", "attr": {"Lang": "ja", "Era": "Meiji", "Year": "29", "Num": "089", "PromulgateMonth": "04", "PromulgateDay": "27", "LawType": "Act"}, "children": [{"tag": "LawBody", "attr": {}, "children": [{"tag": "MainProvision", "attr": {}, "children": [{"tag": "Part", "attr": {"Num": "4"}, "children": [{"tag": "Chapter", "attr": {"Num": "2"}, "children": [{"tag": "Section", "attr": {"Num": "1"}, "children": [{"tag": "Subsection", "attr": {"Num": "1"}, "children": [{"tag": "Article", "attr": {"Num": "733"}, "children": [{"tag": "ArticleTitle", "attr": {}, "children": ["第七百三十三条"]}, {"tag": "Paragraph", "attr": {"Num": "1"}, "children": [{"tag": "ParagraphNum", "attr": {}, "children": []}, {"tag": "ParagraphSentence", "attr": {}, "children": [{"tag": "Sentence", "attr": {"Num": "1", "WritingMode": "vertical"}, "children": ["削除"]}]}]}]}]}]}]}, {"tag": "Chapter", "attr": {"Num": "3"}, "children": [{"tag": "Section", "attr": {"Num": "1"}, "children": [{"tag": "Article", "attr": {"Num": "772"}, "children": [{"tag": "ArticleCaption", "attr": {}, "children": ["（嫡出の推定）"]}, {"tag": "ArticleTitle", "attr": {}, "children": ["第七百七十二条"]}, {"tag": "Paragraph", "attr": {"Num": "1"}, "children": [{"tag": "ParagraphNum", "attr": {}, "children": []}, {"tag": "ParagraphSentence", "attr": {}, "children": [{"tag": "Sentence", "attr": {"Num": "1", "WritingMode": "vertical"}, "children": ["妻が婚姻中に懐胎した子は、当該婚姻における夫の子と推定する。"]}, {"tag": "Sentence", "attr": {"Num": "2", "WritingMode": "vertical"}, "children": ["女が婚姻前に懐胎した子であって、婚姻が成立した後に生まれたものも、同様とする。"]}]}]}, {"tag": "Paragraph", "attr": {"Num": "2"}, "children": [{"tag": "ParagraphNum", "attr": {}, "children": ["２"]}, {"tag": "ParagraphSentence", "attr": {}, "children": [{"tag": "Sentence", "attr": {"Num": "1", "WritingMode": "vertical"}, "children": ["前項の場合において、婚姻の成立の日から二百日以内に生まれた子は、婚姻前に懐胎したものと推定し、婚姻の成立の日から二百日を経過した後又は婚姻の解消若しくは取消しの日から三百日以内に生まれた子は、婚姻中に懐胎したものと推定する。"]}]}]}, {"tag": "Paragraph", "attr": {"Num": "3"}, "children": [{"tag": "ParagraphNum", "attr": {}, "children": ["３"]}, {"tag": "ParagraphSentence", "attr": {}, "children": [{"tag": "Sentence", "attr": {"Num": "1", "WritingMode": "vertical"}, "children": ["第一項の場合において、女が子を懐胎した時から子の出生の時までの間に二以上の婚姻をしていたときは、その子は、その出生の直近の婚姻における夫の子と推定する。"]}]}]}, {"tag": "Paragraph", "attr": {"Num": "4"}, "children": [{"tag": "ParagraphNum", "attr": {}, "children": ["４"]}, {"tag": "ParagraphSentence", "attr": {}, "children": [{"tag": "Sentence", "attr": {"Num": "1", "WritingMode": "vertical"}, "children": ["前三項の規定により父が定められた子について、第七百七十四条の規定によりその父の嫡出であることが否認された場合における前項の規定の適用については、同項中「直近の婚姻」とあるのは、「直近の婚姻（第七百七十四条の規定により子がその嫡出であることが否認された夫との間の婚姻を除く。）」とする。"]}]}]}]}]}]}]}]}]}]}}
# 出生届の審査工程で、判定ルールの無い審査項目（人の確認が要るもの）
PREFIX kos: <https://semantica-agent.example/koseki/schema#>
PREFIX kd: <https://semantica-agent.example/koseki/id/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?item WHERE {
  kd:birth kos:hasStep ?step . ?step kos:stepNumber 2 ; kos:hasItem ?item .
  ?item a kos:ReviewCheck .
  FILTER NOT EXISTS { ?rule kos:implementsCheck ?item }
}

# 非本籍地に届出があったときに加わる作業がある工程
PREFIX kos: <https://semantica-agent.example/koseki/schema#>
PREFIX kd: <https://semantica-agent.example/koseki/id/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?step WHERE {
  ?step a kos:ProcedureStep ; kos:hasItem/kos:hasSubItem* ?item .
  ?item kos:appliesWhen <https://semantica-agent.example/koseki/id/condition/non-honseki-filing> .
}

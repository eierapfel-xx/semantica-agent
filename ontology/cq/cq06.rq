# 現行法で廃止・変更された条文に依存する審査項目
PREFIX kos: <https://semantica-agent.example/koseki/schema#>
PREFIX kd: <https://semantica-agent.example/koseki/id/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT DISTINCT ?item ?treatment ?amendment WHERE {
  ?item kos:currentTreatment ?treatment .
  FILTER (?treatment IN (kos:Changed, kos:Obsolete))
  ?item kos:citesProvision ?p .
  OPTIONAL { ?p kos:partOf ?art }
  ?amendment kos:amends ?article .
  FILTER (?p = ?article || ?art = ?article)
}

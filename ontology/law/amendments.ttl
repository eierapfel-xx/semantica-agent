<https://semantica-agent.example/koseki/id/law/minpo/art/765/version/2026-04-01> a kos:ProvisionVersion ;
    dcterms:identifier "LAW-MINPO-765-V20260401" ;
    prov:wasGeneratedBy <https://semantica-agent.example/koseki/id/activity/amendments-20261116140753> ;
    kos:hasSource <https://semantica-agent.example/koseki/id/source/egov/minpo-765> ;
    kos:reviewStatus kos:LlmDraft ;
    kos:summary "夫婦間に成年に達しない子がある場合、親権者の定めがあること、または親権者の指定を求める家事審判もしくは家事調停の申立てがあることを認めた後でなければ、離婚の届出を受理できない。"@ja ;
    kos:validFrom "2026-04-01"^^xsd:date ;
    kos:versionStatus kos:Current .

<https://semantica-agent.example/koseki/id/law/minpo/art/772/version/2024-04-01> a kos:ProvisionVersion ;
    dcterms:identifier "LAW-MINPO-772-V20240401" ;
    prov:wasGeneratedBy <https://semantica-agent.example/koseki/id/activity/amendments-20261116140753> ;
    kos:hasSource <https://semantica-agent.example/koseki/id/source/egov/minpo-772> ;
    kos:reviewStatus kos:LlmDraft ;
    kos:summary "婚姻前に懐胎し、婚姻成立後に生まれた子も夫の子と推定される。婚姻成立の日から二百日以内に生まれた子は婚姻前の懐胎、二百日を経過した後または婚姻の解消もしくは取消しの日から三百日以内に生まれた子は婚姻中の懐胎と推定される。懐胎から出生までに二以上の婚姻があるときは、直近の婚姻の夫の子と推定される。"@ja ;
    kos:validFrom "2024-04-01"^^xsd:date ;
    kos:versionStatus kos:Current .

<https://semantica-agent.example/koseki/id/law/minpo/art/819/version/2026-04-01> a kos:ProvisionVersion ;
    dcterms:identifier "LAW-MINPO-819-V20260401" ;
    prov:wasGeneratedBy <https://semantica-agent.example/koseki/id/activity/amendments-20261116140753> ;
    kos:hasSource <https://semantica-agent.example/koseki/id/source/egov/minpo-819> ;
    kos:reviewStatus kos:LlmDraft ;
    kos:summary "協議離婚では、協議で父母の双方または一方を親権者と定める。裁判上の離婚では、裁判所が父母の双方または一方を親権者と定める。"@ja ;
    kos:validFrom "2026-04-01"^^xsd:date ;
    kos:versionStatus kos:Current .


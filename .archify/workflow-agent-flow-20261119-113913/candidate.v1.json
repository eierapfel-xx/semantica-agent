  "cards": [
    {
      "dot": "cyan",
      "title": "判定はオントロジーから",
      "items": [
        "判定は judge_birth_case の decision をそのまま伝える（agent.md）",
        "derive が届出期間・婚姻後日数などを計算し、birth-rules.ttl の SHACL シェイプが指摘を出す",
        "職員が触れていない項目は未確認。使うルールは「評価できず」で decision は pending"
      ]
    },
    {
      "dot": "amber",
      "title": "pending のときの往復",
      "items": [
        "Claude が unconfirmed の項目を職員に聞き返す",
        "次のターンで、これまでの内容とまとめて judge_birth_case を呼び直す"
      ]
    },
    {
      "dot": "rose",
      "title": "トレースは LLM の自己申告に頼らない",
      "items": [
        "PreToolUse フックが tool_call と引数、_wrap が tool_result と参照ノードを積む",
        "submit_answer が無ければ最後の文章を推測として残す",
        "ターンごとに 001.json・001.md・001.prov.ttl と decisions.json（ContextGraph）を保存"
      ]
    }
